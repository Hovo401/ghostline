# Plain-HTTP variant of prod.conf.template for GitHub Codespaces, whose port
# forwarding terminates TLS itself — see compose.codespaces.yaml.

server {
    listen 80;

    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /socket.io/ {
        proxy_pass http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}

server {
    listen 8333;

    client_max_body_size 512m;

    location / {
        proxy_pass http://seaweedfs:8333;
        proxy_http_version 1.1;
        # SigV4 signs the public host; Codespaces' proxy may rewrite Host, so pin it
        proxy_set_header Host ${S3_PUBLIC_HOST};
    }
}
