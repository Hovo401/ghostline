# Plain-HTTP variant of prod.conf.template for GitHub Codespaces, whose port
# forwarding terminates TLS itself — see compose.codespaces.yaml.

server {
    listen 80;

    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /socket.io/ {
        proxy_pass http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}

server {
    listen 8333;

    # Parts are capped at MULTIPART_THRESHOLD_BYTES (16 MiB, see
    # packages/contracts) so nginx never needs to buffer more than that in
    # one request; 64m leaves headroom without reopening the door to a
    # single giant unbounded PUT.
    client_max_body_size 64m;
    # Buffering the whole request before forwarding it defeats streaming a
    # large PUT straight through to SeaweedFS and adds needless latency —
    # turn it off so bytes flow as they arrive.
    proxy_request_buffering off;
    # Slow links/large parts can outlast nginx's 60s defaults; large media
    # uploads (up to 1 GiB, see docs/REQUIREMENTS.md §7.6) need more room.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    client_body_timeout 300s;

    location / {
        proxy_pass http://seaweedfs:8333;
        proxy_http_version 1.1;
        # SigV4 signs the public host; Codespaces' proxy may rewrite Host, so pin it
        proxy_set_header Host ${S3_PUBLIC_HOST};
    }
}
