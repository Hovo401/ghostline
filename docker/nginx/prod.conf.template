# Templated by nginx's built-in envsubst entrypoint (docker-entrypoint.d)
# using $DOMAIN from the container environment — see compose.prod.yaml.
# One nginx does TLS + reverse proxy + static SPA serving; see
# docs/REQUIREMENTS.md §7.2 for why there is no separate frontend
# container in prod.

server {
    listen 80;
    server_name ${DOMAIN};

    # certbot's webroot ACME challenge — must stay on plain HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m; # uploads go straight to S3 via presigned URLs — see the :8333 server below

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /socket.io/ {
        proxy_pass http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}

# Dedicated 1:1 proxy to SeaweedFS's S3 API — its own port, no path prefix,
# no rewrite. `StorageService`'s presign client signs the SigV4 canonical
# request against $S3_PUBLIC_URL's *path* too; a shared port + path-prefix
# rewrite makes the signed path disagree with the path SeaweedFS actually
# receives, so every presigned request 403s with SignatureDoesNotMatch —
# see docs/adr/0008-s3-public-url-needs-its-own-port.md. `S3_PUBLIC_URL`
# (compose.prod.yaml) must point straight at this port with no path suffix.
server {
    listen 8333 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 512m;

    location / {
        proxy_pass http://seaweedfs:8333;
        proxy_http_version 1.1;
        # $http_host, NOT $host — see docker/nginx/dev.conf's identical
        # :8333 server for why (SigV4 signs the Host header verbatim, port
        # included; $host strips the port and would break the signature).
        proxy_set_header Host $http_host;
    }
}
