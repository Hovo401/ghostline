# Copy to `.env` and fill in real values before `pnpm dev` or
# `pnpm prod:up`. Never commit `.env` — see .gitignore.
#
# Generate secrets with: openssl rand -base64 48

# ---- App ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Dev: http://localhost (via nginx). Prod: https://<your domain>.
CORS_ORIGIN=http://localhost

# ---- Postgres ----
POSTGRES_USER=ghostline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ghostline
# DATABASE_URL is derived from the three vars above in compose.*.yaml —
# only needed here for running Prisma commands (pnpm db:migrate) from the
# host against the port compose.dev.yaml publishes.
DATABASE_URL=postgresql://ghostline:change-me@localhost:5433/ghostline

# ---- Redis / Valkey ----
REDIS_URL=redis://localhost:6379

# ---- S3 (SeaweedFS) ----
S3_BUCKET=ghostline-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ghostline
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
# Internal (container-to-container) endpoint — compose.*.yaml overrides
# this to http://seaweedfs:8333 for the backend/worker containers; only
# needed here for running the backend directly on the host.
S3_ENDPOINT=http://localhost:8333
# Browser-facing endpoint the SDK signs presigned URLs against — MUST be
# reachable from wherever the browser runs, and MUST NOT carry a path
# prefix: the SigV4 signature covers the request path, so a reverse proxy
# that rewrites the path before forwarding to SeaweedFS (e.g. stripping a
# `/s3` prefix) makes the signed path disagree with the path SeaweedFS
# actually receives — every presigned request 403s with
# SignatureDoesNotMatch. See docker/nginx/dev.conf's dedicated `:8333`
# server (no path, no rewrite) and docs/adr/0008-s3-public-url-needs-its-own-port.md.
# Dev: nginx's :8333 passthrough. Prod: https://<your domain>:8333
# (compose.prod.yaml sets this for you).
S3_PUBLIC_URL=http://localhost:8333

# ---- Media (FR-MEDIA-04) ----
# Max upload size in bytes. Default (100 MB) applies if unset.
MEDIA_MAX_FILE_SIZE_BYTES=100000000

# ---- Auth ----
# 32+ random bytes each, and different from one another.
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-change-me-change-me-change-me

# ---- Prod only: domain + TLS ----
DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com
