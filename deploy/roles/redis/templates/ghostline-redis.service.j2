[Unit]
Description=Redis for Ghostline (BullMQ + Socket.IO adapter)
After=network.target

[Service]
Type=notify
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/ghostline/redis.conf --supervised systemd --daemonize no
Restart=on-failure
MemoryMax=96M

[Install]
WantedBy=multi-user.target
