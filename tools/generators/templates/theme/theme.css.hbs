/*
 * Theme: {{label}} ({{tone}}) — DESIGN-BRIEF.md §2.2/§8.3.
 * Fill in each value, then check contrast (fg/bg ≥ 4.5:1, mute/bg ≥ 3:1)
 * before shipping — `/dev/ui` renders this theme live once it's
 * registered in shared/theme/appearance-store.ts's THEME_IDS.
 */
[data-theme="{{dashCase id}}"] {
  --gl-bg: #000000;
  --gl-bg2: #000000;
  --gl-panel: #000000;
  --gl-line: #000000;
  --gl-fg: #000000;
  --gl-mute: #000000;
  --gl-in: #000000;
  --gl-desk: #000000;
}
