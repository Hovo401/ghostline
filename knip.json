{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [".claude/hooks/*.mjs", "tools/generators/plopfile.mjs"],
      "project": [".claude/hooks/*.mjs", "tools/generators/**/*.mjs"]
    },
    "apps/backend": {
      "entry": ["src/main.ts", "src/main.worker.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "apps/frontend": {
      "entry": ["src/app/main.tsx", "src/routes/**/*.{ts,tsx}", "src/sw.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@fontsource/geologica",
        "@fontsource/jetbrains-mono",
        "@fontsource/pixelify-sans",
        "@fontsource/pt-serif",
        "emojibase-data",
        "tailwindcss",
        "@ghostline/contracts",
        "socket.io-client"
      ],
      "ignore": ["src/shared/api/socket-client.ts", "src/sw-notification-options.d.ts"]
    },
    "apps/mobile": {
      "project": ["*.ts"],
      "ignoreDependencies": ["@capacitor/app"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/config": {}
  },
  "ignoreBinaries": ["prisma"],
  "exclude": ["exports", "types"]
}
