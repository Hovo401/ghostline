// Ghostline — Prisma schema.
//
// MVP build (docs/tasks/BACKLOG.md's M0-M5, tracked in docs/tasks/PROGRESS.md).
// Groups, invites, reactions, disappearing messages and the recovery phrase
// are out of scope for this build (see BACKLOG.md's "Отложено") and their
// fields/models are intentionally absent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  username      String    @unique
  displayName   String
  email         String?   @unique
  passwordHash  String
  recoveryHash  String
  avatarKey     String?
  bio           String?
  role          UserRole  @default(USER)
  showOnline    Boolean   @default(true)
  readReceipts  Boolean   @default(true)
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  chatMemberships ChatMember[]
  messages        Message[]
  attachments     Attachment[]
  blocksMade      Block[]      @relation("BlockedBy")
  blocksReceived  Block[]      @relation("Blocked")

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  familyId   String    @db.Uuid
  userAgent  String?
  ip         String?
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model Chat {
  id            String    @id @default(uuid()) @db.Uuid
  type          ChatType
  directKey     String?   @unique
  lastSeq       BigInt    @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  members  ChatMember[]
  messages Message[]

  @@map("chats")
}

enum ChatType {
  DIRECT
  SAVED
}

model ChatMember {
  chatId           String    @db.Uuid
  userId           String    @db.Uuid
  lastReadSeq      BigInt    @default(0)
  lastDeliveredSeq BigInt    @default(0)
  muted            Boolean   @default(false)
  joinedAt         DateTime  @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_members")
}

model Message {
  id              String    @id @default(uuid()) @db.Uuid
  chatId          String    @db.Uuid
  seq             BigInt
  senderId        String?   @db.Uuid
  clientMessageId String    @db.Uuid
  type            MessageType
  text            String?
  attachmentId    String?   @unique @db.Uuid
  durationMs      Int?
  waveform        Json?
  replyToId       String?   @db.Uuid
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  chat       Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender     User?       @relation(fields: [senderId], references: [id], onDelete: SetNull)
  attachment Attachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@unique([chatId, seq])
  @@unique([senderId, clientMessageId])
  @@map("messages")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  VIDEO
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  uploaderId String   @db.Uuid
  status     UploadStatus @default(PENDING)
  key        String
  mime       String
  size       BigInt
  name       String?
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message  Message?

  @@map("attachments")
}

enum UploadStatus {
  PENDING
  READY
}

model Block {
  userId    String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User @relation("BlockedBy", fields: [userId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([userId, blockedId])
  @@map("blocks")
}
